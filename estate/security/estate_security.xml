<odoo>
    <data noupdate="0">

        <record id="category_1" model="ir.module.category">
            <field name="parent_id" ref="base.module_category_estate"/>
            <field name="name">A</field>
        </record> 

        <record id="category_2" model="ir.module.category">
            <field name="parent_id" ref="base.module_category_estate"/>
            <field name="name">B</field>
        </record> 

        <record id="group_estate_user" model="res.groups">
            <field name="name">Estate User</field>
            <field name="category_id" ref="estate.category_1"/>
        </record>

        <record id="group_estate_manager" model="res.groups">
            <field name="name">Estate Manager</field>
            <field name="implied_ids" eval="[(4, ref('estate.group_estate_user'))]"/>
            <field name="category_id" ref="estate.category_2"/>
        </record>

    </data>
</odoo>
